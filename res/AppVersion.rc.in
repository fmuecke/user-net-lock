#pragma code_page(65001)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@APP_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@APP_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Florian Mücke\0"
            VALUE "FileDescription", "@APP_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@APP_VERSION@\0"
            VALUE "InternalName", "@APP_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Florian Mücke\0"
            VALUE "OriginalFilename", "@APP_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "user-net-lock\0"
            VALUE "ProductVersion", "@APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
